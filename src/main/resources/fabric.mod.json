{
	"schemaVersion": 1,
	"id": "fluidanimations",
	"version": "${version}",
	"name": "Fluid Animations",
	"description": "Animacoes mais fluidas para o jogador, animais, mobs e objetos, com suporte a animacoes customizadas do Blockbench.",
	"authors": ["Voce"],
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": ["com.fluidanimations.FluidAnimationsClient"]
	},
	"mixins": ["fluidanimations.mixins.json"],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
